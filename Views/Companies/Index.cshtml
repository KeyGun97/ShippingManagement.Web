@model List<Company>
@{
    ViewData["Title"] = "Companies";
    var returnTo = Context.Request.Path + Context.Request.QueryString;
    // Delete is an Administrator-only feature; normal users never see the button,
    // and the controller re-checks the role server-side regardless.
    bool isAdmin = Context.Session.GetString("Role") == "Admin";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-buildings me-2"></i>Company Registration & Fleet Tracking</h3>
    <div>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#coModal"><i class="bi bi-plus-lg"></i> New Company</button>
        <div class="btn-group">
            <a class="btn btn-outline-primary" asp-action="ExportExcel" asp-route-q="@ViewBag.Q" asp-route-regularOnly="@ViewBag.RegularOnly">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </a>
            <a class="btn btn-outline-secondary" asp-action="ExportCsv" asp-route-q="@ViewBag.Q" asp-route-regularOnly="@ViewBag.RegularOnly">CSV</a>
            <a class="btn btn-outline-danger" asp-action="Print" target="_blank" asp-route-q="@ViewBag.Q" asp-route-regularOnly="@ViewBag.RegularOnly">
                <i class="bi bi-printer"></i> PDF
            </a>
        </div>
    </div>
</div>

<form method="get" class="row g-2 mb-3 no-print">
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search company name…" /></div>
    <div class="col-md-3 form-check d-flex align-items-center ps-4">
        <input class="form-check-input me-1" type="checkbox" name="regularOnly" value="true" checked="@((bool)ViewBag.RegularOnly)" id="ro" />
        <label class="form-check-label" for="ro">Regular customers only</label>
    </div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Search</button></div>
</form>

<div class="card shadow-sm"><div class="card-body table-responsive">
<table class="table table-sm table-hover">
    <thead><tr>
        <th>Company Name</th><th>Address</th><th>Country</th><th>General Email</th>
        <th>Website</th><th>Telephone</th><th class="text-center">Fleet Size</th><th>Status</th><th></th>
    </tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr class="@(c.Status == "Regular" ? "regular-customer" : "")">
            <td><a asp-action="Details" asp-route-id="@c.CompanyID">@c.CompanyName</a></td>
            <td>@c.Address</td><td>@c.Country</td><td>@c.GeneralEmail</td>
            <td>@c.Website</td><td>@c.Telephone</td>
            <td class="text-center">
                <a asp-controller="Vessels" asp-action="Index"
                   asp-route-companyId="@c.CompanyID" asp-route-companyName="@c.CompanyName"
                   class="text-decoration-none"
                   title="View the @c.FleetCount vessel(s) registered to @c.CompanyName">
                    <span class="badge bg-primary">@c.FleetCount</span>
                </a>
            </td>
            <td>
                @if (c.Status == "Regular") { <span class="badge bg-info text-dark"><i class="bi bi-star-fill"></i> Regular</span> }
                else { <span class="badge bg-secondary">Non-Regular</span> }
            </td>
            <td class="text-nowrap">
                <form method="post" asp-action="SetStatus" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@c.CompanyID" />
                    <input type="hidden" name="returnTo" value="@returnTo" />
                    <input type="hidden" name="status" value="@(c.Status == "Regular" ? "Non-Regular" : "Regular")" />
                    <button class="btn btn-sm @(c.Status == "Regular" ? "btn-outline-secondary" : "btn-outline-info")"
                            title="Toggle Regular / Non-Regular customer status">
                        @(c.Status == "Regular" ? "Set Non-Regular" : "Set Regular")
                    </button>
                </form>
                @if (isAdmin)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger delete-co"
                            data-id="@c.CompanyID" data-name="@c.CompanyName" data-fleet="@c.FleetCount"
                            title="Delete this company (Administrator only — password required)">
                        <i class="bi bi-trash"></i>
                    </button>
                }
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted py-3">No companies found.</td></tr> }
    </tbody>
</table>
</div></div>
@{
    int pg = (int)ViewBag.Page, totalPages = (int)ViewBag.TotalPages, total = (int)ViewBag.Total, ps = (int)ViewBag.PageSize;
    int from = total == 0 ? 0 : (pg - 1) * ps + 1;
    int to = Math.Min(pg * ps, total);
    var rvAll = new Dictionary<string, string?> {
        ["q"] = (string?)ViewBag.Q,
        ["regularOnly"] = ((bool)ViewBag.RegularOnly).ToString(),
        ["pageSize"] = ps.ToString()
    };
    var rv = rvAll.Where(kv => !string.IsNullOrEmpty(kv.Value))
                  .ToDictionary(kv => kv.Key, kv => kv.Value!);
    int winStart = Math.Max(1, pg - 2), winEnd = Math.Min(totalPages, pg + 2);
}
<div class="d-flex justify-content-between align-items-center mt-2 no-print">
    <span class="text-muted small">Showing @from–@to of @total companies</span>
    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(pg <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="rv" asp-route-page="@(pg-1)">&laquo;</a>
                </li>
                @if (winStart > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="rv" asp-route-page="1">1</a></li>
                    @if (winStart > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }
                @for (int p = winStart; p <= winEnd; p++)
                {
                    <li class="page-item @(p == pg ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="rv" asp-route-page="@p">@p</a>
                    </li>
                }
                @if (winEnd < totalPages)
                {
                    @if (winEnd < totalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="rv" asp-route-page="@totalPages">@totalPages</a></li>
                }
                <li class="page-item @(pg >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="rv" asp-route-page="@(pg+1)">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
<p class="text-muted small mt-2">Fleet size updates automatically as vessels are added, removed, or reassigned. Regular-customer rows are shown in blue throughout the system.</p>

<!-- New company modal -->
<div class="modal fade" id="coModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
<form method="post" asp-action="Save">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnTo" value="@returnTo" />
    <div class="modal-header"><h5 class="modal-title">New Company</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body row g-2">
        <div class="col-12"><label class="form-label">Company Name *</label><input name="CompanyName" class="form-control" required /></div>
        <div class="col-12"><label class="form-label">Address</label><input name="Address" class="form-control" /></div>
        <div class="col-6"><label class="form-label">Country</label><input name="Country" class="form-control" /></div>
        <div class="col-6"><label class="form-label">Telephone</label><input name="Telephone" class="form-control" /></div>
        <div class="col-6"><label class="form-label">General Email</label><input name="GeneralEmail" class="form-control" /></div>
        <div class="col-6"><label class="form-label">Website</label><input name="Website" class="form-control" /></div>
        <div class="col-6">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select"><option>Non-Regular</option><option>Regular</option></select>
        </div>
    </div>
    <div class="modal-footer"><button class="btn btn-success">Save</button></div>
</form>
</div></div></div>

@if (isAdmin)
{
    <!-- Delete company modal — Administrator only, password confirmation required -->
    <div class="modal fade" id="delCoModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
        <form method="post" asp-action="Delete" id="delCoForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="del_id" />
            <input type="hidden" name="returnTo" value="@returnTo" />
            <div class="modal-header bg-danger-subtle">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Company</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    You are about to permanently delete
                    <strong id="del_name" class="text-danger"></strong>. This cannot be undone.
                </p>

                <div id="del_fleetWarn" class="alert alert-warning py-2 px-3 small d-none">
                    This company still has <strong id="del_fleet"></strong> vessel(s) registered to it.
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="unlinkVessels" value="true" id="del_unlink" />
                        <label class="form-check-label" for="del_unlink">
                            Also unlink its vessels <em class="text-muted">(the vessels are kept — only the company link is cleared)</em>
                        </label>
                    </div>
                </div>

                <label class="form-label fw-bold mb-1">Administrator password *</label>
                <input type="password" name="adminPassword" id="del_pwd" class="form-control"
                       autocomplete="current-password" placeholder="Re-enter your login password" required />
                <div class="form-text">Only an Administrator can delete a company. Your own login password confirms the action.</div>
                <div id="del_msg" class="text-danger small mt-1"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger"><i class="bi bi-trash"></i> Delete Company</button>
            </div>
        </form>
    </div></div></div>
}

@section Scripts {
    <script>
        // Delete-company dialog (Administrator only — the button only exists for admins).
        $(document).on('click', '.delete-co', function () {
            const b = $(this), fleet = parseInt(b.data('fleet'), 10) || 0;
            $('#del_id').val(b.data('id'));
            $('#del_name').text(b.data('name'));
            $('#del_pwd').val('');
            $('#del_msg').text('');
            $('#del_unlink').prop('checked', false);
            $('#del_fleet').text(fleet);
            $('#del_fleetWarn').toggleClass('d-none', fleet === 0);
            new bootstrap.Modal(document.getElementById('delCoModal')).show();
        });

        // Keep prompting until the password box is filled and, when the company
        // still owns vessels, the unlink option has been acknowledged.
        $(document).on('submit', '#delCoForm', function (e) {
            if (!$('#del_pwd').val()) {
                e.preventDefault();
                $('#del_msg').text('Please enter your Administrator password to confirm.');
                $('#del_pwd').focus();
                return false;
            }
            const fleetShown = !$('#del_fleetWarn').hasClass('d-none');
            if (fleetShown && !$('#del_unlink').is(':checked')) {
                e.preventDefault();
                $('#del_msg').text('This company still has vessels — tick "Also unlink its vessels" to continue.');
                return false;
            }
            return true;
        });
    </script>
}
