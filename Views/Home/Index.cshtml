@{ ViewData["Title"] = "Dashboard"; bool isAdmin = Context.IsAdmin(); }

@*  ── SUPPORT & LICENSING REMINDER ────────────────────────────────────────────
    DISPLAY ONLY. This is a visual reminder that counts down to the 10th of the
    month so the renewal is not forgotten. It performs NO licence check, stores
    nothing, blocks nothing and gates no feature — removing this block removes
    the feature entirely. The date is computed in the browser from the client
    clock; there is no server-side logic behind it.                             *@
<div id="licStrip" class="lic-strip mb-3">
    <div class="lic-ico"><i class="bi bi-shield-check"></i></div>
    <div class="lic-body">
        <div class="lic-title">Licensing</div>
        <div class="lic-sub">Next renewal due <strong id="licDate">—</strong></div>
    </div>
    <div class="lic-clock">
        <div class="lic-count"><span id="licDays">--</span><small>days</small></div>
        <div class="lic-count"><span id="licHrs">--</span><small>hrs</small></div>
        <div class="lic-count"><span id="licMin">--</span><small>min</small></div>
        <div class="lic-count"><span id="licSec">--</span><small>sec</small></div>
    </div>
</div>

<div class="page-head border-0 pb-2 mb-2 d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h3 class="mb-1">Welcome, @Context.CurrentUserName()</h3>
    </div>
</div>

<div class="eyebrow-label mb-3">Overview</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card tile tile-ocean p-3">
            <span class="tile-ico"><i class="bi bi-water"></i></span>
            <div class="display-6" data-count="@ViewBag.Vessels">0</div>
            <div class="tile-label">Registered Vessels</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card tile tile-violet p-3">
            <span class="tile-ico"><i class="bi bi-buildings"></i></span>
            <div class="display-6" data-count="@ViewBag.Companies">0</div>
            <div class="tile-label">Companies</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card tile tile-mint p-3">
            <span class="tile-ico"><i class="bi bi-star-fill"></i></span>
            <div class="display-6" data-count="@ViewBag.Regulars">0</div>
            <div class="tile-label">Regular Customers</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card tile tile-amber p-3">
            <span class="tile-ico"><i class="bi bi-box-arrow-in-down"></i></span>
            <div class="display-6" data-count="@ViewBag.TodayArrivals">0</div>
            <div class="tile-label">Today's Arrivals</div>
        </div>
    </div>
</div>

<div class="eyebrow-label mb-3">Modules</div>
<div class="row g-3">
    @foreach (var (title, icon, url, desc) in new (string, string, string, string)[]
    {
        ("Vessel & Company Registration","bi-water","/Vessels","Register vessels by IMO, manage companies & fleets"),
        ("Import Data","bi-robot","/ImportData","Scraped port data, IMO matching, Useless handling, filtering"),
        ("Daily Report","bi-file-earmark-bar-graph","/DailyReport","Country/date report, single & Asia/Non-Asia exports"),
        ("Master Data","bi-database","/MasterData","Country-wise, company-wise & IMO history tracking"),
        ("Auto Emails","bi-envelope-paper","/AutoEmails","Send Confirm / Purchase / Catering & other emails to vessel contacts"),
        ("Regular Customers","bi-star-fill","/RegularCustomers","Dedicated dashboard for regular customers & their fleets"),
    })
    {
        <div class="col-md-6 col-xl-4">
            <a href="@url" class="text-decoration-none">
                <div class="card h-100">
                    <div class="card-body d-flex gap-3">
                        <div class="mod-ico"><i class="bi @icon"></i></div>
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">@title</h6>
                            <p class="text-muted small mb-0">@desc</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
    @if (isAdmin)
    {
        <div class="col-md-6 col-xl-4">
            <a href="/PortAssignments" class="text-decoration-none">
                <div class="card h-100" style="border-color:rgba(255,196,107,.4)">
                    <div class="card-body d-flex gap-3">
                        <div class="mod-ico mod-amber"><i class="bi bi-diagram-3"></i></div>
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">Port Assignment & Auto Data</h6>
                            <p class="text-muted small mb-0">Assign ports to users and distribute scraped data automatically</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        /*  Support & licensing countdown — PURELY VISUAL.
            Counts down to 00:00 on the 10th of the month. No licence key, no
            validation, no expiry check, no feature gating: it only renders text.
            If today is past the 10th it rolls forward to the 10th of next month. */
        (function () {
            const strip = document.getElementById('licStrip');
            if (!strip) return;

            const pad = n => String(n).padStart(2, '0');
            const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

            function nextDueDate() {
                const now = new Date();
                let due = new Date(now.getFullYear(), now.getMonth(), 10, 0, 0, 0, 0);
                if (now >= due) due = new Date(now.getFullYear(), now.getMonth() + 1, 10, 0, 0, 0, 0);
                return due;
            }

            function tick() {
                const now = new Date();
                const due = nextDueDate();
                let diff = Math.max(0, due - now);

                const d = Math.floor(diff / 86400000); diff -= d * 86400000;
                const h = Math.floor(diff / 3600000);  diff -= h * 3600000;
                const m = Math.floor(diff / 60000);    diff -= m * 60000;
                const s = Math.floor(diff / 1000);

                document.getElementById('licDays').textContent = pad(d);
                document.getElementById('licHrs').textContent  = pad(h);
                document.getElementById('licMin').textContent  = pad(m);
                document.getElementById('licSec').textContent  = pad(s);
                document.getElementById('licDate').textContent =
                    due.getDate() + ' ' + MONTHS[due.getMonth()] + ' ' + due.getFullYear();

                // Colour states are cosmetic only — nothing is disabled at any point.
                strip.classList.remove('lic-due', 'lic-soon');
                if (d <= 2)      strip.classList.add('lic-due');
                else if (d <= 7) strip.classList.add('lic-soon');
            }

            tick();
            setInterval(tick, 1000);
        })();
    </script>
}
